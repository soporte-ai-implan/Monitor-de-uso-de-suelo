# Copia este archivo como .env y llena los valores.
# .env esta en .gitignore: NO se sube al repo.

# --- Apify (obligatorio) ---
# Token de la cuenta de Apify. Consola -> Settings -> Integrations -> API tokens
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tope de resultados por fuente en cada corrida. Es una RED, no una perilla de
# costo: tiene que quedar POR ENCIMA del inventario real (~120 hoy).
#
# No lo bajes para gastar menos. Los anuncios que no llegan se leen como
# desaparecidos, y el blindaje de database.py no lo atrapa porque solo detecta
# fuentes que devuelven cero, no fuentes que devuelven de menos: la corrida
# reportaria decenas de bajas falsas. Para gastar menos se baja la FRECUENCIA
# del cron (ver LEEME-VICTOR.md).
#
# Ojo: el Actor de Pincali exige >= 10. Con menos truena con
# "Field input.maxItems must be >= 10", lo cual solo se ve con --max chico.
MAX_RESULTADOS_POR_FUENTE=200

# --- Nominatim (OpenStreetMap) ---
# Su politica de uso exige un contacto real en el User-Agent. Si se deja el
# valor por omision y se abusa del servicio, bloquean la IP.
NOMINATIM_CONTACTO=soporte-ai@trcimplan.gob.mx

# --- API ---
# Dominios que pueden hacer fetch() a la API, separados por coma.
# En produccion conviene acotarlo, por ejemplo:
#   CORS_ORIGENES=https://trcimplan.gob.mx,https://www.trcimplan.gob.mx
CORS_ORIGENES=*

# --- Scheduler ---
# Cada cuantas horas corre el pipeline (ver scheduler.py y docs/scheduler.md).
INTERVALO_HORAS=24

# --- Despliegue en contenedor (Railway) ---
# Ponlo en 1 SOLO en el servidor: hace que la API corra el pipeline por dentro,
# sin necesitar un cron aparte. En tu maquina dejalo en 0 o quitalo, si no cada
# vez que levantes la API se pondria a scrapear.
SCHEDULER_EN_API=0

# Carpeta donde viven terrenos.db y el cache de geocoding.
# En Railway apunta al volumen persistente montado, por ejemplo /data.
# Si no la defines, todo queda junto al codigo (bien para desarrollo local).
# OJO: sin volumen, cada redeploy borra la base y se pierde el historial de
# altas y bajas, que es lo que le da sentido al monitor.
# DATOS_DIR=/data
